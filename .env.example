# Telegram adapter only. CLI parse / preview and MCP do not need this.
# NEVER commit the real token.
BOT_TOKEN=
# Public bot username without @ — used by the web desk deep link.
VITE_TELEGRAM_BOT=cairov2_bot

# Public URL of the Vercel desk. Telegram CONFIRM points here to sign.
DESK_URL=https://cairobot.vercel.app
VITE_DESK_URL=https://cairobot.vercel.app

# Optional. Protects POST /api/telegram if you switch the bot to webhook.
TELEGRAM_WEBHOOK_SECRET=

# CLI / agent desk only. Telegram must never use this key.
OPERATOR_ADDRESS=
OPERATOR_PRIVATE_KEY=

# Optional. Public marks work without it; live positions need it.
EXTENDED_API_KEY=

# Deployed MarginRouter. Empty = confirm() fails closed.
MARGIN_ROUTER=
VITE_MARGIN_ROUTER=

# Mainnet defaults — override only if you know why.
NETWORK=mainnet
CHAIN_ID=SN_MAIN
RPC_URL=https://rpc.starknet.lava.build
POOL=0x040337b1af3c663e86e333bab5a4b28da8d4652a15a69beee2b677776ffe812a
USDC=0x053c91253bc9682c04929ca02ed00b3e423f6710d2ee7e0d5ebb06f3ecf368a8
EXTENDED_API=https://api.starknet.extended.exchange
EXTENDED_VENUE=0x062da0780fae50d68cecaa5a051606dc21217ba290969b302db4dd99d2e9b470
